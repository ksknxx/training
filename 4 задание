from collections.abc import Hashable
def v(data_list):
    result = set()
    print(f"Исходный список: {data_list}")
    for item in data_list:
        if isinstance(item, Hashable):
            try:
                result.add(item)
                print(f"  Добавлен: {item}")
            except:
                print(f"  Не удалось добавить: {item}")
        else:
            print(f"  Пропущен (нехешируемый): {item}")
    print(f"Получившееся множество: {result}")
    return result
m = [
    1, 2, 3,
    "привет",
    2.5,
    [1, 2, 3],
    (4, 5, 6),
    {"a": 1},
    "птица",
    2,
    {"яблоко", "банан"},
    True,
    None,
    False,
]

v(m)
