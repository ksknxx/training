n = int(input("Введите двузначное число: "))
c = int(input("Введите трехзначное число: "))

a = n // 10
b = n % 10
print("Сумма цифр двузначного:", a + b)
print("Произведение цифр двузначного:", a * b)

f = c // 100
d = (c // 10) % 10
e = c % 10
print("Сумма цифр трехзначного:", f + d + e)
print("Произведение цифр трехзначного:", f * d * e)
