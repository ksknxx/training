a = []
b = []
a.append(4.5)
a.append(100)
a.append(3.4)
a.append(100)
a.append(8.7)
a.append(1.3)
b.append(200)
b.append(14.5)
b.append(200)
b.append(3.4)
b.append(8.7)
b.append(11.3)
print("Исходные списки:")
print("1:", a)
print("2:", b)
del a[0]
del b[0]
a.remove(100)
b.remove(200)
print("\nПосле удалений:")
print("1", a)
print("2:", b)
sa = set(a)
sb = set(b)
sa_and_sb = sa & sb
print("\nУникальные элементы:")
print("1:", list(sa))
print("2:", list(sb))
print("общие:", list(sa_and_sb))
c = a + b
c_asc = sorted(c)
c_desc = sorted(c, reverse=True)
k = c[1::2]
sr_ar = sum(k) / len(k)
p = c[0::2]
product = 1
for num in p:
    product *= num
sr_geom = product ** (1/len(p))
c_max = max(c)
c_min = min(c)
print("\nИтоговые:")
print("3:", c)
print("Сортировка (возр.):", c_asc)
print("Сортировка (убыв.):", c_desc)
print("Ср. арифм. =", round(sr_ar, 2))
print("Ср. геометр. =", round(sr_geom, 2))
print("Макс. и мин.:", c_max, c_min)
