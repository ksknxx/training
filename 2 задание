def r(t, elem):
    if elem not in t:
        return ()
    index1 = t.index(elem)
    c = t[index1 + 1:]
    if elem in c:
        second_index = index1 + 1 + c.index(elem)
        return t[index1:second_index + 1]
    else:
        return t[index1:]
